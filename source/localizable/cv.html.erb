---
title_key: meta.cv_title
description_key: meta.cv_description
section: cv
---
<section class="hero hero--compact">
  <h1 class="hero__name"><%= t('cv.title') %></h1>
  <p class="hero__role"><%= t('home.name') %> &middot; <%= t('home.role') %></p>
  <%# Middleman's `t` helper drops keyword args on Ruby 3, so go through I18n. %>
  <p class="hero__intro"><%= I18n.t('cv.lead', experience: total_experience) %></p>
</section>

<section class="section">
  <h2 class="section__title"><span class="section__sigil">##</span> <%= t('cv.sections.skills') %></h2>
  <dl class="skills">
    <% t('cv.skill_groups').each do |group| %>
      <div class="skills__group">
        <dt class="skills__title"><%= group[:title] %></dt>
        <dd class="skills__items">
          <ul class="tags">
            <% group[:items].each do |item| %>
              <li class="tag"><%= item %></li>
            <% end %>
          </ul>
        </dd>
      </div>
    <% end %>
  </dl>
</section>

<section class="section">
  <h2 class="section__title"><span class="section__sigil">##</span> <%= t('cv.sections.experience') %></h2>
  <ol class="timeline">
    <% t('cv.jobs').each do |job| %>
      <li class="entry">
        <div class="entry__period">
          <span class="entry__dates"><%= entry_period(job) %></span>
          <span class="entry__duration"><%= job_duration(job) %></span>
        </div>
        <div class="entry__body">
          <h3 class="entry__title"><%= job[:company] %></h3>
          <p class="entry__role"><%= job[:role] %></p>
          <p class="entry__meta"><%= job[:location] %></p>
        </div>
      </li>
    <% end %>
  </ol>
</section>

<section class="section">
  <h2 class="section__title"><span class="section__sigil">##</span> <%= t('cv.sections.education') %></h2>
  <ol class="timeline">
    <% t('cv.schools').each do |school| %>
      <li class="entry">
        <div class="entry__period">
          <span class="entry__dates"><%= entry_period(school) %></span>
        </div>
        <div class="entry__body">
          <h3 class="entry__title"><%= school[:place] %></h3>
          <p class="entry__role"><%= school[:faculty] %></p>
          <p class="entry__meta"><%= school[:location] %></p>
          <ul class="entry__list">
            <% school[:details].each do |detail| %>
              <li><%= detail %></li>
            <% end %>
          </ul>
        </div>
      </li>
    <% end %>
  </ol>
</section>

<section class="section">
  <h2 class="section__title"><span class="section__sigil">##</span> <%= t('cv.sections.courses') %></h2>
  <ol class="timeline">
    <% t('cv.courses').each do |course| %>
      <li class="entry">
        <div class="entry__period">
          <span class="entry__dates"><%= entry_period(course) %></span>
        </div>
        <div class="entry__body">
          <h3 class="entry__title"><%= course[:title] %></h3>
          <p class="entry__role"><%= course[:place] %></p>
          <ul class="entry__list">
            <% course[:details].each do |detail| %>
              <li><%= detail %></li>
            <% end %>
          </ul>
        </div>
      </li>
    <% end %>
  </ol>
</section>

<section class="section">
  <h2 class="section__title"><span class="section__sigil">##</span> <%= t('cv.sections.community') %></h2>
  <ol class="timeline">
    <% t('cv.community').each do |item| %>
      <li class="entry">
        <div class="entry__period">
          <span class="entry__dates"><%= entry_period(item) %></span>
        </div>
        <div class="entry__body">
          <h3 class="entry__title">
            <%= link_to item[:place], item[:url] %>
          </h3>
          <p class="entry__role"><%= item[:text] %></p>
        </div>
      </li>
    <% end %>
  </ol>
</section>

<section class="section">
  <h2 class="section__title"><span class="section__sigil">##</span> <%= t('cv.sections.about') %></h2>
  <% t('cv.about').each do |paragraph| %>
    <p class="prose"><%= paragraph %></p>
  <% end %>
</section>

<section class="section">
  <h2 class="section__title"><span class="section__sigil">##</span> <%= t('home.contacts_title') %></h2>
  <dl class="contacts">
    <div class="contacts__row">
      <dt class="contacts__key"><%= t('contacts.email') %></dt>
      <dd class="contacts__value"><a href="mailto:edenisn@gmail.com">edenisn@gmail.com</a></dd>
    </div>
    <div class="contacts__row">
      <dt class="contacts__key"><%= t('contacts.telegram') %></dt>
      <dd class="contacts__value"><a href="https://t.me/edenisn" rel="me">@edenisn</a></dd>
    </div>
    <div class="contacts__row">
      <dt class="contacts__key"><%= t('contacts.github') %></dt>
      <dd class="contacts__value"><a href="https://github.com/edenisn" rel="me">github.com/edenisn</a></dd>
    </div>
    <div class="contacts__row">
      <dt class="contacts__key"><%= t('contacts.habr') %></dt>
      <dd class="contacts__value"><a href="https://career.habr.com/erofeevdn" rel="me">career.habr.com/erofeevdn</a></dd>
    </div>
  </dl>
</section>
