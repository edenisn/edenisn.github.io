<!doctype html>
<html lang="<%= I18n.locale %>">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= t(current_page.data.title_key) %></title>
    <meta name="description" content="<%= t(current_page.data.description_key) %>">
    <meta name="author" content="<%= t('home.name') %>">
    <meta name="theme-color" content="#0c0e0b">

    <link rel="canonical" href="<%= absolute_url(locale_path(current_slug)) %>">
    <% site_langs.each do |lang| %>
      <link rel="alternate" hreflang="<%= lang %>"
            href="<%= absolute_url(locale_path(current_slug, locale: lang)) %>">
    <% end %>
    <link rel="alternate" hreflang="x-default"
          href="<%= absolute_url(locale_path(current_slug, locale: :ru)) %>">

    <meta property="og:type" content="profile">
    <meta property="og:site_name" content="<%= t('home.name') %>">
    <meta property="og:title" content="<%= t(current_page.data.title_key) %>">
    <meta property="og:description" content="<%= t(current_page.data.description_key) %>">
    <meta property="og:url" content="<%= absolute_url(locale_path(current_slug)) %>">
    <meta property="og:locale" content="<%= I18n.locale == :ru ? 'ru_RU' : 'en_US' %>">
    <% other_langs.each do |lang| %>
      <meta property="og:locale:alternate" content="<%= lang == :ru ? 'ru_RU' : 'en_US' %>">
    <% end %>
    <meta property="og:image" content="<%= absolute_url('/images/portrait.jpg') %>">
    <meta property="og:image:alt" content="<%= t('home.portrait_alt') %>">
    <meta name="twitter:card" content="summary">

    <script type="application/ld+json"><%= person_schema %></script>

    <%= stylesheet_link_tag 'site' %>
  </head>
  <body class="page page--<%= current_section %>">
    <div class="scanlines" aria-hidden="true"></div>

    <div class="shell">
      <header class="topbar">
        <p class="prompt">
          <span class="prompt__user">visitor@edenisn.ru</span><span class="prompt__sep">:</span><span class="prompt__path">~</span><span class="prompt__sigil">$</span>
        </p>
        <nav class="nav" aria-label="<%= t('nav.label') %>">
          <%= nav_link('home', '') %>
          <%= nav_link('cv', 'cv') %>
          <span class="nav__langs">
            <span class="nav__lang is-current" aria-current="true"><%= t('lang_name') %></span>
            <% other_langs.each do |lang| %>
              <%# Middleman's `t` helper drops keyword args on Ruby 3, so go through I18n. %>
              <a href="<%= locale_path(current_slug, locale: lang) %>"
                 class="nav__lang" lang="<%= lang %>" rel="alternate"><%= I18n.t('lang_name', locale: lang) %></a>
            <% end %>
          </span>
        </nav>
      </header>

      <main class="main">
        <%= yield %>
      </main>

      <footer class="footer">
        <p>
          <span class="footer__dim"><%= t('footer.built') %></span>
          &middot;
          <a href="https://github.com/edenisn/edenisn.github.io"><%= t('footer.source') %></a>
        </p>
      </footer>
    </div>
  </body>
</html>
